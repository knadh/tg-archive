lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Local runtime and user files
/main.js
config.yaml
*.session
*.session-journal
data.sqlite*
site/
media/
